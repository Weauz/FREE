32512 ICON "free.ico"
1 24 "setup.manifest"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "NetLance"
      VALUE "FileDescription", "Installation de FREE"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "FREE-Installation"
      VALUE "LegalCopyright", "\251 2026 NetLance"
      VALUE "OriginalFilename", "FREE-Installation.exe"
      VALUE "ProductName", "FREE - French Reverse Engineer Everything"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
